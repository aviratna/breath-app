{
  "expo": {
    "name": "Breath",
    "slug": "breath-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aviratna.breath"
    },
    "android": {
      "package": "com.aviratna.breath",
      "adaptiveIcon": {
        "backgroundColor": "#161514",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "78fb96e4-fe67-4c7d-827d-328a8674f131"
      }
    },
    "scheme": "breath",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6A78",
          "defaultChannel": "breaths"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "Breath",
              "label": "Breath",
              "description": "Your day of breaths, and your people a tap away",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
